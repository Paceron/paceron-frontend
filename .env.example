# Copiar a .env (gitignored) y ajustar según necesidad. Expo lee este archivo
# automáticamente al arrancar el dev server (requiere reiniciarlo si lo editás
# con el server corriendo — las vars EXPO_PUBLIC_* se inyectan al bundlear).

# URL base del backend. Sin esta var, cae al backend remoto en Render por
# default (ver config/env.js). Para apuntar a un backend local:
# EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Usar datos mockeados en vez de pegarle al backend real (login/registro
# funcionan sin backend disponible). Ver services/auth-mock.js.
# EXPO_PUBLIC_USE_MOCKS=true

# Origen de la web deployada (Vercel) — usado por el checkout nativo
# (WebView) para saber qué URL cargar. Sin esta var, cae a producción real.
# Para apuntar a un dev server local (dispositivo físico en la misma red
# WiFi que la máquina que corre `npm run web`):
# EXPO_PUBLIC_WEB_ORIGIN=http://192.168.1.23:8082
