{
  "name": "paceron-frontend",
  "version": "0.17.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "eas:build:preview": "npx eas-cli build --platform android --profile preview",
    "eas:build:android:preview:local": "mkdir -p builds && npx eas-cli build --platform android --profile preview --local --output ./builds/paceron-preview-v$npm_package_version.apk",
    "eas:build:production": "npx eas-cli build --platform android --profile production",
    "eas:build:android:production:local": "mkdir -p builds && npx eas-cli build --platform android --profile production --local --output ./builds/paceron-production-v$npm_package_version.apk",
    "eas:deploy:develop": "npx eas-cli workflow:run .eas/workflows/deploy-develop.yml",
    "eas:deploy:production": "npx eas-cli workflow:run .eas/workflows/deploy-production.yml",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@mercadopago/sdk-react": "^1.0.7",
    "@react-native-community/datetimepicker": "8.4.4",
    "@tanstack/react-query": "^5.100.10",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "^8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "nativewind": "^4.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-confirmation-code-field": "^9.0.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.13"
  },
  "private": true,
  "devDependencies": {
    "@expo/metro-config": "54.0.17",
    "@testing-library/react-native": "^13.3.3",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "node-fetch": "^3.3.2",
    "react-test-renderer": "19.1.0",
    "typescript": "5.9.3"
  }
}
